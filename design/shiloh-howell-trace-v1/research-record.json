    {
      "id": "HW02",
      "status": "source_attributed_unadjudicated",
      "claim": "Cadle describes report comparison, Washington research and participant interviews, alongside missing/meager reports.",
      "limit": "General self-described method does not identify Howell testimony or validate the narrative.",
      "citations": [
        {
          "source_id": "reed-1903-howell-v1",
          "section": "p5-cadle-method",
          "locator": "p5-cadle-method",
          "quote": "To secure this accuracy all reports have been carefully studied and compared. The records at Washington have been thoroughly searched and many who participated in the battle have been interviewed. Unfortunately many organizations that served at Shiloh failed to make official reports; others made such meager statements of service that it is difficult to give credit that is doubtless due to gallant organizations.",
          "raw_sha256": "ecbc66668bfaa87834de5b3b753500addc2d542fbdf61af126d4e5602b235387",
          "source_metadata_sha256": "c04c93501f7ae05d74c4587f7b31c9f4c689931c0abd94e851321fe32cb3a32c",
          "document_date": null,
