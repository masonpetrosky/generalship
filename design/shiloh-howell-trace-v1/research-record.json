    {
      "id": "HW03",
      "status": "source_attributed_unadjudicated",
      "claim": "Medkirk's dated 1886 letter reports Saturday firing east of Howell farm, an evening cavalry brush, and a departing officer party.",
      "limit": "Retrospective letter; no original manuscript inspected. A party riding away is not termination of all Saturday contact. Enemy identity and link to Reed or Sunday remain unknown.",
      "citations": [
        {
          "source_id": "medkirk-1886-howell-v1",
          "section": "p537-saturday",
          "locator": "p537-saturday",
          "quote": "The next day, Saturday, my company, 'E,' and Company 'C' constituted the brigade picket. We were stationed on the east side of the Howell farm [see page 502]. All day the enemy kept in our front. We fired on them frequently, but they did not return the fire until toward evening, when they had a brush with a squadron of the 5th Ohio Cavalry.",
          "raw_sha256": "7386c22f750e43ffe3cc6194792217ae197eeb8ed7ef9947cd8128a88b7d5c7a",
          "source_metadata_sha256": "7babe86552ad3d0fc1fdd7cb45e41c79ed3a56b2eb0e8d389715f5a71a1dd3d4",
          "document_date": "1886-03-22",
          "historical_knowledge_at": null,
          "visually_checked_facsimile_ids": [
            "medkirk-howell-p537-facsimile-v1"
          ],
          "html_parent_source_id": null
        },
        {
          "source_id": "medkirk-1886-howell-v1",
          "section": "p537-officer-party",
          "locator": "p537-officer-party",
          "quote": "Late Saturday afternoon, a Confederate officer with his staff rode up on a knoll on the west side of the Howell farm, and with his glass began to take observations; in a few minutes we opened fire on them and they rode rapidly away.",
          "raw_sha256": "7386c22f750e43ffe3cc6194792217ae197eeb8ed7ef9947cd8128a88b7d5c7a",
          "source_metadata_sha256": "7babe86552ad3d0fc1fdd7cb45e41c79ed3a56b2eb0e8d389715f5a71a1dd3d4",
          "document_date": "1886-03-22",
          "historical_knowledge_at": null,
          "visually_checked_facsimile_ids": [
            "medkirk-howell-p537-facsimile-v1"
          ],
          "html_parent_source_id": null
        }
      ]
    },
    {
      "id": "HW04",
      "status": "source_attributed_unadjudicated",
      "claim": "Worthington prints Sharpe/Crary accounts of Saturday expulsion around 7 a.m., house occupation, and Sherman's contrary denial.",
      "limit": "One adversarial edited publication, not three authenticated independent transcripts. House occupation does not demonstrate continuous fire; farm/house/local posts and clocks not reconciled.",
      "citations": [
        {
          "source_id": "worthington-1872-howell-v1",
          "section": "p140-sharpe-expulsion",
          "locator": "p140-sharpe-expulsion",
          "quote": "The pickets were driven from the Howell house on Saturday about 7 a. m. There were no pickets that I know of in front of the Howell house on the Corinth road.",
          "raw_sha256": "d788db7f16a74cfacbdeaeb5ba11aba6b151aa72d4fbe9d21e9110d9632c029b",
          "source_metadata_sha256": "9088c2677b13e9575855af524e18028d4fe679da170c7382fae2bea7d2eb8ec3",
