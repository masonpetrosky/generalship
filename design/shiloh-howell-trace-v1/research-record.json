  "assertions": [
    {
      "id": "HW01",
      "status": "source_attributed_unadjudicated",
      "claim": "The Howell clause is present in Reed's GPO 1903 printing and revised 1909 text.",
      "limit": "Same compiler lineage, not independent witnesses. The inspected paragraph has no footnote marker attached to the Howell clause. No participant-to-Reed attribution established.",
      "citations": [
        {
          "source_id": "reed-1903-howell-v1",
          "section": "p68-howell",
          "locator": "p68-howell",
          "quote": "The Third Corps in its advance from Mickey's had a skirmish on Friday in which a few prisoners were taken on both sides; another engagement with a picket post near Howell's on Saturday, and on Sunday morning the picket of this corps, under Major Hardcastle, stationed at the corner of Fraley's and Wood's fields, was attacked at 4.55 a. m. by a reconnoitering party sent out by General Prentiss.",
