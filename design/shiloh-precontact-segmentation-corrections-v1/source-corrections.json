  "citation_corrections": [
    {
      "assertion_id": "PS05",
      "source_before": "or-april4-march-orders-v1",
      "source_after": "or-april4-march-orders-v2",
      "section": "p391-jordan-revision",
      "quote_before": "The commanding general directs me to say, on reflection, he wishes you to march promptly with your command at 3 o'clock in the morning in support of the movement ordered to be made at that hour by Generals Hardee and Bragg. It is of the utmost importance for the success of this movement that your troops shall move precisely at the time designated.",
